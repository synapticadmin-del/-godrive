# ==========================================
# Comprehensive GitIgnore for GoDrive MonoRepo
# ==========================================

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
**/node_modules/
node_modules/
.npm/
.pnpm-store/
.yarn/
yarn-error.log
npm-debug.log*
lerna-debug.log*
.turbo/

# ------------------------------------------
# Build Outputs & Generated Assets
# ------------------------------------------
**/dist/
dist/
**/build/
build/
**/.wrangler/
.wrangler/
**/out/
out/
.next/
*.apk
*.aab
*.ipa
*.app
*.app.zip
*.dSYM

# ------------------------------------------
# Flutter / Dart Specifics
# ------------------------------------------
**/.dart_tool/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/doc/api/
**/android/app/debug
**/android/app/profile
**/android/app/release

# ------------------------------------------
# Android & iOS Platform Build Artifacts
# ------------------------------------------
**/android/.gradle/
**/android/app/build/
**/android/local.properties
**/android/.idea
**/ios/Pods/
**/ios/Podfile.lock
**/ios/.symlinks/
**/ios/Runner.xcworkspace/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec

# ------------------------------------------
# Environment & Secrets (SECURITY)
# ------------------------------------------
.env
.env.*
!.env.example
.dev.vars
*.local
google-services*.json
GoogleService-Info.plist
*.keystore
*.jks
key.properties
*.pem
*.pub
*.key

# ------------------------------------------
# IDEs & Editor Temp Files
# ------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp
*.log

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
coverage/
**/coverage/
.nyc_output/

# ------------------------------------------
# Tooling / Agent Session State
# ------------------------------------------
.zcode/

# ------------------------------------------
# Repo-root binary assets pending manual move to docs/assets/
# (GODRIVE.png, splash.mp4, screenshots — move them then delete this note)
# ------------------------------------------
